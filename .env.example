# Public Supabase project configuration; safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Canonical public CRM URL used for staff invitation links.
NEXT_PUBLIC_SITE_URL=https://fastbreakcrm.test

# Server-only. Encrypts saved card numbers / CVV / ACH details (AES-256-GCM). Must be 32 random
# bytes, base64-encoded. Generate one with:  openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Keep it secret and never change it once cards are saved (old entries could not be decrypted).
CARD_ENCRYPTION_KEY=

# Email (server only). All CRM email goes FROM support@fastbreakcrm.test with Reply-To info@,
# through your mail host. Never Gmail (a Gmail SMTP host or From address is refused).
SMTP_HOST=smtp.example.test
SMTP_PORT=465
# SMTP_SECURE defaults to true on port 465 (SSL)
SMTP_USER=support@fastbreakcrm.test
SMTP_PASS=
# info@ Inbox (your mail host IMAP). Defaults: IMAP_HOST=imap.example.test when SMTP is your mail host,
# IMAP_PORT=993, IMAP_USER=SMTP_USER, IMAP_PASS=SMTP_PASS. MAIL_SYNC_SECRET guards /api/cron/mail-sync.
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASS=
MAIL_SYNC_SECRET=
# Optional overrides (both default to support@fastbreakcrm.test)
EMAIL_FROM_ADDRESS=support@fastbreakcrm.test
EMAIL_REPLY_TO=support@fastbreakcrm.test
EMAIL_FROM_NAME=Fastbreak CRM
# Website quote notices use these same email settings and go to WEBSITE_LEAD_NOTICE_TO (default support@fastbreakcrm.test).
# If nothing is set, the quote is still saved and Assign New Estimates shows that the email did not send.

# Network Login (/) = the company login, checked server-side before User Login.
# Network ID is matched trimmed + case-insensitive; the password exactly. Missing = nobody gets in.
NETWORK_ID=
NETWORK_PASSWORD=
# Optional: signs the network session cookie (default: derived from CARD_ENCRYPTION_KEY)
NETWORK_SESSION_SECRET=

# Stripe (optional). Leave all three blank until the partner's Stripe account is ready.
# Nothing is charged while the secret and publishable keys are blank. Use test keys first
# (sk_test_ and pk_test_). Both keys must be test, or both must be live. A mismatch turns charging off.
# PAYMENTS_PROVIDER is not used.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from Stripe (whsec_...). Endpoint: /api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed,
# checkout.session.completed, setup_intent.succeeded.
# Without this secret, a Stripe notification is not marked paid.
STRIPE_WEBHOOK_SECRET=

# Fast Break demo: internal alert recipients (placeholders; set your own).
OPS_ALERT_EMAIL=ops@fastbreakcrm.test
WEBSITE_LEAD_NOTICE_TO=support@fastbreakcrm.test
# Optional Zelle payee shown to customers. Blank = no Zelle instructions.
PAY_ZELLE=
